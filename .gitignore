# Claude Code artifacts
.claude/plans/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Your household: Martha's config and memory hold personal details
martha-config.md
martha-memory.json
martha-memory.broken-*.json
martha-plan-*.md
profile-location.txt
outputs/
