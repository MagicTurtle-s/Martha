*.env
.env.*
credentials.json
*-credentials.json
*token*.json
secrets.json
.secrets-out/

# Release zips are built outside the repository; never commit one
*.zip
settings.local.json

# Release checks: the deny-list names real people and places, so it stays local
release/*.local.*

# Scratch files some Claude tools leave behind
tmpclaude-*

# Node modules (if any tooling is added)
node_modules/

# Python (if any tooling is added)
__pycache__/
*.pyc
.venv/
venv/
